# Copia a .env.local (desarrollo) o define estas variables en Vercel. NUNCA subas claves al repositorio.

# URL pública (SEO, sitemap, datos estructurados)
NEXT_PUBLIC_SITE_URL=https://reyked.cl

# Panel /admin: usuario, contraseña larga y clave para firmar la sesión (mínimo 32 caracteres aleatorios).
# Sin ADMIN_PASSWORD y SESSION_SECRET el panel queda deshabilitado.
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=

# Base de datos de pedidos, gastos y ajustes. En Vercel: Marketplace > Upstash Redis (crea estas variables).
# En local se usa la carpeta .data/ (DATA_DIR para cambiarla). En Vercel sin Redis, los pedidos NO se guardan.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
