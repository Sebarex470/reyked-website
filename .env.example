# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# Access Token de Mercado Pago (Tus integraciones > Credenciales). Usa el de PRUEBA para probar.
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
# URL pública del sitio (https en producción; Mercado Pago no acepta localhost para webhooks).
PUBLIC_URL=http://localhost:3000
# Clave secreta del webhook (Tus integraciones > Webhooks). Recomendado en producción.
MP_WEBHOOK_SECRET=
# Acceso al panel /admin.html. Sin ADMIN_PASSWORD el panel queda deshabilitado. Usa una clave larga.
ADMIN_USER=admin
ADMIN_PASSWORD=
PORT=3000
